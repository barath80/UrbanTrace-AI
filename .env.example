# Copy to .env and fill in. .env is git-ignored - never commit real credentials.
ROBOFLOW_API_KEY=your_roboflow_key
ROBOFLOW_MODEL_ID=indian-license-plate-detection-6tmbr/1

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_DB_PASSWORD=<database-password>
SUPABASE_REGION=ap-south-1
SUPABASE_POOLER_PORT=5432
SUPABASE_PREFER=pooler

# GraphHopper Routing API - real road geometry between cameras.
# Free key from https://graphhopper.com/dashboard/. Server-side only.
GRAPHHOPPER_API_KEY=your_graphhopper_key

# ---------------------------------------------------------------- production
# Self-hosted / managed Postgres (PostGIS). When set it replaces SUPABASE_*.
# DATABASE_URL=postgresql://user:password@host:5432/urbantrace
# UT_DB_SSLMODE=prefer
# Compose database password (docker-compose.yml builds DATABASE_URL from it).
# POSTGRES_PASSWORD=change-me
HTTP_PORT=80

# API protection. Unset = open (development). Writes need the key; set
# UT_API_AUTH=all to require it for reads as well.
# UT_API_KEY=generate-a-long-random-string
# UT_API_AUTH=writes
# Comma-separated origins allowed to call the API cross-origin (default: none).
# UT_CORS_ORIGINS=https://dashboard.example.org

# Ingest tuning (all optional; see backend/urbantrace/scale/config.py).
# UT_TARGET_FPS=6          analysed frames per second per camera
# UT_INFER_WORKERS=2
# UT_BATCH_SIZE=8
# UT_MOTION_GATE=1
# UT_SHARD_CELL_KM=3
