# Copy to .env and fill in. .env is git-ignored - never commit real credentials.
ROBOFLOW_API_KEY=your_roboflow_key
ROBOFLOW_MODEL_ID=indian-license-plate-detection-6tmbr/1

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_PUBLISHABLE_KEY=<publishable-key>
SUPABASE_DB_PASSWORD=<database-password>
SUPABASE_REGION=ap-south-1
SUPABASE_POOLER_PORT=5432
SUPABASE_PREFER=pooler

# GraphHopper Routing API - real road geometry between cameras.
# Free key from https://graphhopper.com/dashboard/. Server-side only.
GRAPHHOPPER_API_KEY=your_graphhopper_key
